# TURN server credentials (required for production WebRTC reliability)
# Sign up at https://www.metered.ca/stun-turn or similar service
#
# TURN_URLS can be a single URL or comma-separated list:
#   turn:global.relay.metered.ca:443?transport=tcp
#   turn:global.relay.metered.ca:80?transport=tcp,turns:global.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
